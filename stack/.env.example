# Exemplo de .env para rodar 'docker compose' MANUALMENTE em stack/.
# O comando 'pca-setup hosting' gera um .env completo (com segredos reais);
# este arquivo serve so para quem prefere subir a stack na mao.
#
# Copie para .env e ajuste:
#   cp .env.example .env

# --- Build contexts (obrigatorios para 'docker compose build') ---
# Pastas dos repos clonados pelo bootstrap (default do hosting).
BACKEND_DIR=../projeto-ong-amar/backend
FRONTEND_DIR=../projeto-ong-amar/frontend
# Pasta deste stack/ (onde estao os Dockerfiles). Use caminho absoluto.
STACK_DIR=.

# --- Config da app (gerada de verdade pelo 'pca-setup hosting') ---
# O hosting sobrescreve/gera estes valores com aleatoriedade criptografica.
# Abaixo so ha placeholders p/ subir a stack sem o hosting.
DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost
REQUIRE_HTTPS=false
COOKIE_SECURE=false
MYSQL_ROOT_PASSWORD=troque-me
DB_USER=amar
DB_PASSWORD=troque-me
JWT_SECRET=troque-me
SECURITY_PEPPER=troque-me
JWT_VALIDITY=86400
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NOME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@amar.local
BOOTSTRAP_ADMIN_SENHA=troque-me
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAIL_FROM=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
